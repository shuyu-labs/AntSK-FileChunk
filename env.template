# AntSK FileChunk 环境变量配置模板
# 复制此文件为 .env 并修改相应的值

# ==================== 服务配置 ====================
# 服务监听地址
APP_HOST=0.0.0.0

# 服务监听端口
APP_PORT=8000

# 日志级别 (debug, info, warning, error, critical)
LOG_LEVEL=info

# 是否开启开发模式
DEVELOPMENT=false

# ==================== 应用配置 ====================
# 最大文件上传大小 (单位: MB)
MAX_UPLOAD_SIZE=100

# 工作进程数量
WORKER_PROCESSES=1

# 临时文件保存时间 (单位: 小时)
TEMP_FILE_RETENTION_HOURS=24

# ==================== 切片默认配置 ====================
# 默认最小切片大小
DEFAULT_MIN_CHUNK_SIZE=200

# 默认最大切片大小
DEFAULT_MAX_CHUNK_SIZE=1500

# 默认目标切片大小
DEFAULT_TARGET_CHUNK_SIZE=800

# 默认重叠比例
DEFAULT_OVERLAP_RATIO=0.1

# 默认语义阈值
DEFAULT_SEMANTIC_THRESHOLD=0.7

# 默认语言设置 (zh/en)
DEFAULT_LANGUAGE=zh

# ==================== 模型配置 ====================
# 语义模型名称 (可选，留空使用默认模型)
SEMANTIC_MODEL_NAME=

# 模型缓存目录
MODEL_CACHE_DIR=./models

# 是否使用GPU加速 (true/false)
USE_GPU=false

# ==================== 数据库配置 (可选) ====================
# 如果需要数据库支持，可以添加以下配置
# DATABASE_URL=postgresql://user:password@localhost:5432/antsk_filechunk
# REDIS_URL=redis://localhost:6379/0

# ==================== 监控配置 (可选) ====================
# 是否启用性能监控
ENABLE_METRICS=false

# Prometheus 监控端口
METRICS_PORT=9090

# ==================== 安全配置 ====================
# API 密钥 (可选，用于API访问控制)
# API_KEY=your-secret-api-key

# CORS 允许的源
CORS_ORIGINS=*

# 是否启用请求限流
ENABLE_RATE_LIMITING=false

# 每分钟最大请求数
MAX_REQUESTS_PER_MINUTE=60

# ==================== 文件存储配置 ====================
# 上传文件存储路径
UPLOAD_PATH=./temp

# 日志文件存储路径
LOG_PATH=./logs

# 配置文件路径
CONFIG_PATH=./config

# ==================== Docker 特定配置 ====================
# Docker 容器时区
TZ=Asia/Shanghai

# Python 相关
PYTHONPATH=/app
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
